+#ifdef _WIN32
+/* Normalize all backslashes to forward slashes in-place. */
+void normalize_slashes(char *path)
+{
+	if (path == NULL)
+		return;
+	for (char *p = path; *p != '\0'; p++) {
+		if (*p == '\\')
+			*p = '/';
+	}
+}
+#endif
