+/*
+ * Switch the terminal's mouse reporting on or off, so that terminals
+ * such as Windows Terminal forward mouse events (including the scroll
+ * wheel) to the application.
+ *
+ * Two mechanisms are needed:
+ *
+ * 1. Under a pseudo-console (ConPTY, i.e. Windows Terminal, VS Code, ...),
+ *    the hosting conhost absorbs mouse DECSET sequences written to the
+ *    output handle.  The only way to ask the attached terminal to report
+ *    mouse events is the Win32 console flag ENABLE_MOUSE_INPUT on the
+ *    input handle: conhost then emits \e[?1003;1006h to the terminal
+ *    (microsoft/terminal#9970).  Unfortunately quick-edit mode suppresses
+ *    mouse input, so it must be turned off in the same SetConsoleMode
+ *    call.  conhost only relays when the *effective* ENABLE_MOUSE_INPUT
+ *    flag changes, so toggle it off first to force a state change.
+ *
+ * 2. A classic console (or a terminal hosting conhost in passthrough
+ *    mode) has no VT mouse protocol of its own; the wheel arrives as
+ *    MOUSE_EVENT_RECORDs regardless.  For hosts with passthrough mode,
+ *    also emit the standard VT mouse-tracking sequences when the output
+ *    is processed as VT; in a classic console without VT they would show
+ *    up as garbage, so they are gated on ENABLE_VIRTUAL_TERMINAL_PROCESSING.
+ */
+NCURSES_EXPORT(void)
+_nc_console_mouse_tracking(int enable)
+{
+    /* 1006 = SGR encoding, 1000 = report button presses and wheel rolls. */
+    static const char on_seq[] = "\033[?1006h\033[?1000h";
+    static const char off_seq[] = "\033[?1000l\033[?1006l";
+    /* Whether quick-edit mode was on before we started tracking (-1: unknown). */
+    static int quickedit_saved = -1;
+    DWORD mode = 0;
+    DWORD written = 0;
+    HANDLE hdl;
+    const char *seq;
+    size_t len;
+
+    T((T_CALLED("lib_win32con::_nc_console_mouse_tracking(%d)"), enable));
+
+    if (!console_initialized)
+	returnVoid;
+
+    /*
+     * Win32 input-flag relay (works under ConPTY as well as in a classic
+     * console, where quick-edit mode would otherwise swallow the wheel).
+     */
+    hdl = WINCONSOLE.inp;
+    if (hdl != INVALID_HANDLE_VALUE && GetConsoleMode(hdl, &mode)) {
+	if (enable) {
+	    mouse_tracking_active = 1;
+	    if (quickedit_saved < 0)
+		quickedit_saved = (mode & ENABLE_QUICK_EDIT_MODE) ? 1 : 0;
+	    /* Turn the mouse flag off (with quick-edit still suppressed)
+	     * and on again, so that conhost is guaranteed to notice the
+	     * change and relay the mouse mode to the terminal.  Toggling
+	     * quick-edit mode requires ENABLE_EXTENDED_FLAGS. */
+	    SetConsoleMode(hdl,
+			   ((mode & ~(ENABLE_MOUSE_INPUT |
+				      ENABLE_QUICK_EDIT_MODE)) |
+			    ENABLE_EXTENDED_FLAGS));
+	    SetConsoleMode(hdl,
+			   ((mode & ~ENABLE_QUICK_EDIT_MODE) |
+			    ENABLE_EXTENDED_FLAGS |
+			    ENABLE_MOUSE_INPUT));
+	} else {
+	    mouse_tracking_active = 0;
+	    if (quickedit_saved > 0) {
+		/* Restore quick-edit mode; conhost relays the loss of the
+		 * effective mouse flag, so the terminal stops reporting. */
+		quickedit_saved = -1;
+		SetConsoleMode(hdl,
+			       ((mode | ENABLE_QUICK_EDIT_MODE) |
+				ENABLE_EXTENDED_FLAGS));
+	    } else if (quickedit_saved == 0) {
+		/* Quick-edit was already off; drop the mouse flag to end
+		 * the relay. */
+		quickedit_saved = -1;
+		SetConsoleMode(hdl,
+			       (mode & ~(ENABLE_MOUSE_INPUT |
+					 ENABLE_EXTENDED_FLAGS |
+					 ENABLE_QUICK_EDIT_MODE)));
+	    }
+	}
+    }
+
+    /* DECSET fallback for passthrough-mode hosts. */
+    hdl = OutHandle();
+    if (hdl == INVALID_HANDLE_VALUE ||
+	!GetConsoleMode(hdl, &mode) ||
+	!(mode & ENABLE_VIRTUAL_TERMINAL_PROCESSING))
+	returnVoid;
+
+    if (enable) {
+	seq = on_seq;
+	len = sizeof(on_seq) - 1;
+    } else {
+	seq = off_seq;
+	len = sizeof(off_seq) - 1;
+    }
+    WriteConsoleA(hdl, seq, (DWORD) len, &written, NULL);
+    returnVoid;
+}
