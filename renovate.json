{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GNU nano",
      "managerFilePatterns": ["/^build\\.sh$/"],
      "matchStrings": ["NANO_VER=\"(?<currentValue>[^\"]*)\""],
      "depNameTemplate": "nano",
      "packageNameTemplate": "homebrew/nano",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Update ncurses",
      "managerFilePatterns": ["/^build\\.sh$/"],
      "matchStrings": ["NCURSES_VER=\"(?<currentValue>[^\"]*)\""],
      "depNameTemplate": "ncurses",
      "packageNameTemplate": "homebrew/ncurses",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Update LLVM MinGW",
      "managerFilePatterns": ["/^build\\.sh$/"],
      "matchStrings": ["LLVM_MINGW_VER=\"(?<currentValue>[^\"]*)\""],
      "depNameTemplate": "mstorsjo/llvm-mingw",
      "datasourceTemplate": "github-tags"
    }
  ]
}
